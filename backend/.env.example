# CarPlus Backend — variables de entorno
# Ver Technical Spec v2.1 §17.6. Agrupadas por fase del roadmap (§16.1):
# las de fases futuras están comentadas y no se validan todavía (ver
# src/config/env.validation.ts) — existen aquí solo como documentación de
# lo que vendrá, para no tener que redescubrir el nombre de cada variable
# fase a fase.

# ── Fase 1 — Plataforma ──
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:8081

# PostgreSQL local vía Docker Compose (ver docker-compose.yml en la raíz).
# pgvector viaja en la misma instancia (imagen pgvector/pgvector).
DATABASE_URL="postgresql://carplus:carplus@localhost:5432/carplus?schema=public"

# ── Fase 2 — Identidad (Supabase Auth) ──
# Project Settings → API, en supabase.com. SUPABASE_ANON_KEY es pública
# por diseño (Supabase la protege con RLS/policies), pero igual solo vive
# en el backend — el móvil nunca la conoce (proxy vía /auth/*, D-004).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Requisito operativo: el proyecto debe tener "JWT Signing Keys"
# (asimétrico) activo, no el sistema legacy de secreto compartido — si no,
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json devuelve "keys": [] y el
# guard de autenticación no puede verificar ningún token (ver D-004).

# ── Fase 6 — Storage (Evidencia) ──
# service_role key (Project Settings → API → "service_role secret").
# Bypassea RLS a nivel de proyecto entero (Postgres y Storage) — Supabase
# no ofrece una variante restringida solo a Storage. Nunca se expone al
# cliente móvil (vive solo en el backend, D-004). Requiere un bucket
# privado llamado "evidence" ya creado en el dashboard de Supabase Storage
# antes de arrancar con esta variable puesta.
SUPABASE_SERVICE_ROLE_KEY=

# ── Fase 3b — Vehicle Data Provider (alcance mínimo: solo adaptador nulo) ──
VEHICLE_DATA_PROVIDER=null
# Sin adaptador real todavía — no hay claves que configurar.
# VEHICLE_DATA_PROVIDER_API_KEY_CHILE=

# ── Fase 5 — AI Chat (Claude/Anthropic, primer proveedor real) ──
AI_PROVIDER=claude
# Modelo a usar — ajustar según el modelo Claude vigente disponible.
AI_MODEL=claude-sonnet-5
AI_API_KEY_CLAUDE=
AI_TIMEOUT_MS=15000
# Sin adaptador OpenAI/Gemini todavía — no hay claves que configurar.
# AI_API_KEY_OPENAI=
# AI_API_KEY_GEMINI=

# ── Fase 7 — Informes ──
# generateReport() es asíncrono (vía jobs, sin espera en vivo del
# usuario) y su contexto/salida son más grandes que un turno de chat —
# timeout propio, más generoso que AI_TIMEOUT_MS.
AI_REPORT_TIMEOUT_MS=60000

# ── Fase 5b — RAG técnico (pipeline real, corpus vacío) ──
RAG_EMBEDDING_PROVIDER=null
RAG_MAX_CHUNKS_PER_QUERY=5
# Sin proveedor real de embeddings todavía — no hay modelo/clave que
# configurar (RAG_EMBEDDING_MODEL queda para cuando exista uno).
# RAG_EMBEDDING_MODEL=

# ── Fase 6 — Evidencia ──
# Referencia: 25 MB. Ajustable sin cambiar código.
MAX_UPLOAD_SIZE=26214400
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/quicktime,audio/mpeg,audio/mp4,audio/wav

# ── Observabilidad — aún no integrado ──
# ERROR_TRACKING_DSN=
