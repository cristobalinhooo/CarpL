# CarPlus Backend — variables de entorno
# Ver Technical Spec v2.1 §17.6. Agrupadas por fase del roadmap (§16.1):
# las de fases futuras están comentadas y no se validan todavía (ver
# src/config/env.validation.ts) — existen aquí solo como documentación de
# lo que vendrá, para no tener que redescubrir el nombre de cada variable
# fase a fase.

# ── Fase 1 — Plataforma ──
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:8081

# PostgreSQL local vía Docker Compose (ver docker-compose.yml en la raíz).
# pgvector viaja en la misma instancia (imagen pgvector/pgvector).
DATABASE_URL="postgresql://carplus:carplus@localhost:5432/carplus?schema=public"

# ── Fase 2 — Identidad (Supabase Auth) ──
# Project Settings → API, en supabase.com. SUPABASE_ANON_KEY es pública
# por diseño (Supabase la protege con RLS/policies), pero igual solo vive
# en el backend — el móvil nunca la conoce (proxy vía /auth/*, D-004).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Requisito operativo: el proyecto debe tener "JWT Signing Keys"
# (asimétrico) activo, no el sistema legacy de secreto compartido — si no,
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json devuelve "keys": [] y el
# guard de autenticación no puede verificar ningún token (ver D-004).

# ── Fase 6 — Storage (Evidencia) — aún no integrado ──
# SUPABASE_SERVICE_ROLE_KEY=

# ── Fase 3b — Vehicle Data Provider (alcance mínimo: solo adaptador nulo) ──
VEHICLE_DATA_PROVIDER=null
# Sin adaptador real todavía — no hay claves que configurar.
# VEHICLE_DATA_PROVIDER_API_KEY_CHILE=

# ── Fase 5 — AI Engine — aún no integrado ──
# AI_PROVIDER=
# AI_MODEL=
# AI_API_KEY_OPENAI=
# AI_API_KEY_CLAUDE=
# AI_API_KEY_GEMINI=
# AI_TIMEOUT_MS=15000

# ── Fase 5b — RAG técnico — aún no integrado ──
# RAG_EMBEDDING_PROVIDER=
# RAG_EMBEDDING_MODEL=
# RAG_MAX_CHUNKS_PER_QUERY=5

# ── Fase 6 — Evidencia — aún no integrado ──
# MAX_UPLOAD_SIZE=
# ALLOWED_MIME_TYPES=

# ── Observabilidad — aún no integrado ──
