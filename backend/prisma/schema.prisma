// CarPlus — Prisma Schema
// Fase 1 (Plataforma): tabla `jobs` que respalda el módulo `jobs`
// (Technical Spec §9.12, §10.6d).
// Fase 2 (Identidad): tabla `users`, perfil local vinculado a Supabase Auth
// (Technical Spec §10.3). Nunca almacena password — las credenciales son
// 100% responsabilidad de Supabase Auth.
//
// La extensión `pgvector` se habilita desde ya porque es infraestructura de
// Fase 1 ("PostgreSQL (+pgvector)", roadmap §16.1), aunque el primer modelo
// que la use (`DocumentChunk`, RAG técnico) llega recién en la Fase 5b.
// Fase 3 (Vehículos): tabla `vehicles` — solo registro manual por ahora.
// `registration_method`/`data_source`/`data_synced_at` ya existen en la
// entidad unificada (Technical Spec §10.4) pero el backend nunca los
// setea a otra cosa que MANUAL/null hasta la Fase 3b.
// Fase 3b (Vehicle Data Provider): tabla `vehicle_lookup_logs` (§10.5)
// para trazabilidad de cada búsqueda por patente. Alcance mínimo: solo
// existe el adaptador nulo (siempre NOT_FOUND), así que `vehicle_id`
// queda siempre null aquí — solo se llenaría si una búsqueda tuviera
// éxito, y eso no puede pasar todavía.
// Fase 4 (Investigaciones): tablas `investigations` e
// `investigation_state_logs`. Máquina de estados de 7 estados según
// D-002 (que restauró READY_TO_ANALYZE, corrigiendo una simplificación
// no documentada del Technical Spec §9.10 original). Solo Draft y Active
// son alcanzables por API en esta fase — el resto de la tabla de
// transiciones existe completa desde ya para no requerir un refactor
// cuando Evidence/AI/Reports (Fases 5-7) empiecen a disparar el resto.
// Fase 5 (AI Chat): tablas `messages`, `hypotheses`, `hypothesis_revisions`
// (§10.6, §10.6c). `Message.isSafetyStop`/`safetyMessage` persisten la
// señal de seguridad de la IA (§14.10, PRD §124/§237) de forma
// consultable, no solo como texto libre — sin funcionalidad nueva
// alrededor todavía. `Hypothesis.evidenceRefs` queda siempre vacío: no
// existe Evidence hasta la Fase 6.
// Fase 5b (RAG técnico): tablas `technical_documents`, `document_chunks`
// (§10.7) — `embedding` es `Unsupported("vector(1536)")` porque Prisma no
// modela `vector` como tipo nativo; toda escritura/lectura de esa columna
// pasa por SQL crudo parametrizado (tagged-template de Prisma, nunca
// concatenación de strings). `rag_retrieval_logs` (§10.7, D-009) audita
// cada recuperación: `chunk_ids` = lo ofrecido al modelo,
// `referenced_chunk_ids` = lo que el modelo citó realmente según su
// propia salida estructurada — dos señales distintas, ninguna se pierde.
// Alcance mínimo: el pipeline de ingesta/recuperación es real, pero el
// corpus queda vacío (sin documentos reales cargados todavía).
// Fase 6 (Evidencia): tablas `evidence`/`attachments` (§10.6). D-011: sin
// `deletedAt` — el PRD (RSE-008) prohíbe el borrado de evidencia sin
// excepción, a diferencia de otras entidades. `analysisJson` queda null
// hasta que el job ANALYZE_EVIDENCE la complete, o para siempre en
// VIDEO/AUDIO (Claude solo analiza IMAGE en esta fase — limitación
// documentada, no un bloqueo).
// Las demás entidades (Reports, ...) se añaden en sus fases
// correspondientes del roadmap, no de una sola vez aquí.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum JobType {
  ANALYZE_EVIDENCE
  GENERATE_REPORT
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Cola ligera de tareas asíncronas (Technical Spec §9.12, §10.6d).
/// Único módulo que conoce esta tabla: `jobs`. `Evidence` y `Reports`
/// (fases futuras) solo encolan y consultan estado a través de `JobsService`.
model Job {
  id            String    @id @default(uuid())
  jobType       JobType   @map("job_type")
  status        JobStatus @default(PENDING)
  /// `evidence_id` o `investigation_id`, según `job_type`.
  referenceId   String    @map("reference_id")
  attempts      Int       @default(0)
  correlationId String    @map("correlation_id")
  /// Solo mensaje sanitizado — nunca stack trace ni payload de proveedor (§10.6d).
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, jobType], map: "idx_jobs_status_job_type")
  @@index([correlationId], map: "idx_jobs_correlation_id")
  @@map("jobs")
}

/// Perfil de aplicación vinculado a Supabase Auth (Technical Spec §10.3).
/// Nunca almacena `password_hash` — las credenciales pertenecen a Supabase.
model User {
  id             String    @id @default(uuid())
  /// `sub` del JWT de Supabase Auth (auth.users.id).
  supabaseAuthId String    @unique @map("supabase_auth_id")
  email          String    @unique
  fullName       String    @map("full_name")
  profileImage   String?   @map("profile_image")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  vehicles          Vehicle[]
  vehicleLookupLogs VehicleLookupLog[]
  investigations    Investigation[]

  @@map("users")
}

enum VehicleRegistrationMethod {
  MANUAL
  PLATE_LOOKUP
}

/// Vehículos propiedad del usuario (Technical Spec §10.4). Entidad
/// unificada para registro manual y por patente — en esta fase
/// (Vehículos, manual) `registrationMethod` es siempre `MANUAL` y
/// `dataSource`/`dataSyncedAt` siempre `null`; los setea la Fase 3b.
model Vehicle {
  id                 String                    @id @default(uuid())
  userId             String                    @map("user_id")
  brand              String
  model              String
  version            String?
  year               Int
  engine             String?
  displacement       String?
  fuelType           String?                   @map("fuel_type")
  transmission       String?
  traction           String?
  mileage            Int?
  vin                String?
  plate              String?
  registrationMethod VehicleRegistrationMethod @default(MANUAL) @map("registration_method")
  dataSource         String?                   @map("data_source")
  dataSyncedAt       DateTime?                 @map("data_synced_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  deletedAt          DateTime?                 @map("deleted_at")

  user           User               @relation(fields: [userId], references: [id])
  lookupLogs     VehicleLookupLog[]
  investigations Investigation[]

  @@index([userId, deletedAt], map: "idx_vehicles_user_id_deleted_at")
  @@index([plate], map: "idx_vehicles_plate")
  @@map("vehicles")
}

enum VehicleLookupStatus {
  SUCCESS
  NOT_FOUND
  PROVIDER_ERROR
}

/// Traza de cada búsqueda por patente contra un Vehicle Data Provider
/// (Technical Spec §10.5). No persiste el payload crudo del proveedor —
/// minimización de datos.
model VehicleLookupLog {
  id           String              @id @default(uuid())
  userId       String              @map("user_id")
  /// Nulo mientras la búsqueda no derive en un vehículo guardado. Con
  /// el adaptador nulo (única implementación en esta fase) siempre es
  /// null: nunca hay un SUCCESS que confirmar todavía.
  vehicleId    String?             @map("vehicle_id")
  plateInput   String              @map("plate_input")
  providerName String              @map("provider_name")
  status       VehicleLookupStatus
  createdAt    DateTime            @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([userId, createdAt], map: "idx_vehicle_lookup_log_user_id_created_at")
  @@map("vehicle_lookup_logs")
}

enum InvestigationStatus {
  DRAFT
  ACTIVE
  WAITING_EVIDENCE
  READY_TO_ANALYZE
  ANALYZING
  REPORT_GENERATED
  CLOSED
}

enum ResponsibleComponent {
  FRONTEND
  BACKEND
  INVESTIGATION_ENGINE
  DECISION_ENGINE
  LEARNING_SYSTEM
}

/// Caso mecánico y su ciclo de vida (Technical Spec §10.6). Solo Draft y
/// Active son alcanzables por API en esta fase — el resto de la máquina
/// de estados (§9.10, corregida por D-002) existe completa desde ya.
model Investigation {
  id              String              @id @default(uuid())
  vehicleId       String              @map("vehicle_id")
  userId          String              @map("user_id")
  title           String
  description     String
  currentStatus   InvestigationStatus @default(DRAFT) @map("current_status")
  /// Siempre null en esta fase — nada la calcula todavía (igual que
  /// `Vehicle.dataSource` antes de la Fase 3b).
  confidenceScore Decimal?            @map("confidence_score")
  startedAt       DateTime?           @map("started_at")
  finishedAt      DateTime?           @map("finished_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  /// Solo se usa mientras el caso está en Draft (D-006, "Eliminar caso"
  /// del PRD Estado 1) — ningún otro estado permite esta operación.
  deletedAt       DateTime?           @map("deleted_at")

  vehicle             Vehicle                 @relation(fields: [vehicleId], references: [id])
  user                User                    @relation(fields: [userId], references: [id])
  stateLogs           InvestigationStateLog[]
  messages            Message[]
  hypotheses          Hypothesis[]
  hypothesisRevisions HypothesisRevision[]
  ragRetrievalLogs    RagRetrievalLog[]
  evidence            Evidence[]
  reports             Report[]

  @@index([userId, createdAt], map: "idx_investigations_user_id_created_at")
  @@index([vehicleId, createdAt], map: "idx_investigations_vehicle_id_created_at")
  @@index([currentStatus], map: "idx_investigations_current_status")
  @@map("investigations")
}

/// Auditoría inmutable (append-only) de cada transición de estado
/// (§10.6b, RC-004/RC-005). Ninguna operación de dominio puede
/// actualizar ni eliminar sus filas.
model InvestigationStateLog {
  id                   String               @id @default(uuid())
  investigationId      String               @map("investigation_id")
  /// Nulo solo para la fila de creación inicial (entrada a Draft).
  previousStatus       InvestigationStatus? @map("previous_status")
  newStatus            InvestigationStatus  @map("new_status")
  triggeringEvent      String               @map("triggering_event")
  responsibleComponent ResponsibleComponent @map("responsible_component")
  createdAt            DateTime             @default(now()) @map("created_at")

  investigation Investigation @relation(fields: [investigationId], references: [id])

  @@index([investigationId, createdAt], map: "idx_investigation_state_log_investigation_id_created_at")
  @@map("investigation_state_logs")
}

enum MessageSender {
  USER
  AI
  SYSTEM
}

/// Conversación cronológica del caso (Technical Spec §10.6).
model Message {
  id              String        @id @default(uuid())
  investigationId String        @map("investigation_id")
  sender          MessageSender
  message         String
  /// Señal de seguridad de la IA (§14.10 `safety.stop`/`safety.message`,
  /// PRD §124/§237) persistida como dato consultable, no solo enterrada
  /// como texto libre dentro de `message`. Sin funcionalidad nueva
  /// alrededor todavía en esta fase — solo se guarda, no se pierde.
  isSafetyStop    Boolean       @default(false) @map("is_safety_stop")
  safetyMessage   String?       @map("safety_message")
  createdAt       DateTime      @default(now()) @map("created_at")

  investigation       Investigation        @relation(fields: [investigationId], references: [id])
  hypothesisRevisions HypothesisRevision[]
  ragRetrievalLogs    RagRetrievalLog[]

  @@index([investigationId, createdAt], map: "idx_messages_investigation_id_created_at")
  @@index([investigationId, isSafetyStop], map: "idx_messages_investigation_id_safety_stop")
  @@map("messages")
}

enum HypothesisStatus {
  ACTIVE
  DISCARDED
  PARTIALLY_CONFIRMED
}

/// Hipótesis evolutivas y su confianza — estado actual (Technical Spec
/// §10.6). El historial completo de cambios vive en `HypothesisRevision`.
model Hypothesis {
  id              String           @id @default(uuid())
  investigationId String           @map("investigation_id")
  hypothesis      String
  confidence      Decimal
  reasoning       String
  status          HypothesisStatus @default(ACTIVE)
  /// Referencias a evidencia — siempre vacío en esta fase, Evidence llega
  /// recién en la Fase 6.
  evidenceRefs    Json?            @map("evidence_refs")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  investigation Investigation        @relation(fields: [investigationId], references: [id])
  revisions     HypothesisRevision[]

  @@index([investigationId, status], map: "idx_hypotheses_investigation_id_status")
  @@map("hypotheses")
}

/// Historial inmutable (append-only) de cada cambio de una hipótesis
/// (§10.6c, RC-005). Se escribe antes o junto con cada actualización de
/// `Hypothesis.status`/`confidence`.
model HypothesisRevision {
  id                   String            @id @default(uuid())
  hypothesisId         String            @map("hypothesis_id")
  investigationId      String            @map("investigation_id")
  previousConfidence   Decimal?          @map("previous_confidence")
  newConfidence        Decimal           @map("new_confidence")
  previousStatus       HypothesisStatus? @map("previous_status")
  newStatus            HypothesisStatus  @map("new_status")
  reasoningSnapshot    String            @map("reasoning_snapshot")
  triggeredByMessageId String?           @map("triggered_by_message_id")
  createdAt            DateTime          @default(now()) @map("created_at")

  hypothesis         Hypothesis    @relation(fields: [hypothesisId], references: [id])
  investigation      Investigation @relation(fields: [investigationId], references: [id])
  triggeredByMessage Message?      @relation(fields: [triggeredByMessageId], references: [id])

  @@index([hypothesisId, createdAt], map: "idx_hypothesis_revision_hypothesis_id_created_at")
  @@index([investigationId, createdAt], map: "idx_hypothesis_revision_investigation_id_created_at")
  @@map("hypothesis_revisions")
}

enum TechnicalDocumentSourceType {
  MANUAL
  BULLETIN
  MANUFACTURER_DOC
  OTHER_AUTHORIZED
}

enum TechnicalDocumentStatus {
  ACTIVE
  DEPRECATED
}

/// Documentación técnica autorizada ingerida al corpus RAG (§10.7, §9.8).
/// La ingesta es un proceso operado por el equipo del producto, sin
/// endpoint público (§11.3). Corpus vacío en la Fase 5b: la
/// infraestructura es real, pero no hay documentos reales cargados
/// todavía.
model TechnicalDocument {
  id           String                      @id @default(uuid())
  title        String
  sourceType   TechnicalDocumentSourceType @map("source_type")
  authorizedBy String                      @map("authorized_by")
  version      String
  status       TechnicalDocumentStatus     @default(ACTIVE)
  /// Alcance opcional (marca/modelo/rango de años aplicable).
  vehicleScope Json?                       @map("vehicle_scope")
  storagePath  String                      @map("storage_path")
  ingestedAt   DateTime                    @default(now()) @map("ingested_at")

  chunks DocumentChunk[]

  @@index([status], map: "idx_technical_documents_status")
  @@index([sourceType], map: "idx_technical_documents_source_type")
  @@map("technical_documents")
}

/// Fragmento indexado con embedding (§10.7). `embedding` es
/// `Unsupported` porque Prisma no modela `vector` como tipo nativo —
/// todo insert/lectura de esa columna específica pasa por SQL crudo
/// (`$executeRaw`/`$queryRaw`, siempre con tagged-template parametrizado,
/// nunca concatenación de strings); el resto de las columnas usa Prisma
/// Client normal. Dimensión 1536 (tamaño común de embeddings) es un
/// valor de referencia, trivialmente migrable mientras el corpus esté
/// vacío, como ahora. Índice vectorial (`hnsw`) agregado a mano en la
/// migración — Prisma no genera sintaxis de índices pgvector.
model DocumentChunk {
  id          String                      @id @default(uuid())
  documentId  String                      @map("document_id")
  /// Orden dentro del documento.
  chunkIndex  Int                         @map("chunk_index")
  contentText String                      @map("content_text")
  embedding   Unsupported("vector(1536)")
  /// Aproximado (`Math.ceil(length / 4)`), no un tokenizer real — solo
  /// para control de tamaño de contexto.
  tokenCount  Int                         @map("token_count")

  document TechnicalDocument @relation(fields: [documentId], references: [id])

  @@map("document_chunks")
}

/// Traza de auditoría de cada recuperación RAG por interacción (§10.7,
/// §14.10) — exclusivamente de auditoría/explicabilidad, nunca de
/// aprendizaje (no confundir con la Base de Conocimiento, fuera del MVP).
/// `chunkIds`: fragmentos ofrecidos al modelo como contexto.
/// `referencedChunkIds` (D-009, corrige una discrepancia entre §10.7 y
/// §14.10): el subconjunto que el modelo efectivamente citó en
/// `assistantMessage`, según su propia salida estructurada
/// (`referencedDocuments`) — señal distinta, ambas se conservan.
model RagRetrievalLog {
  id                 String   @id @default(uuid())
  investigationId    String   @map("investigation_id")
  messageId          String?  @map("message_id")
  chunkIds           Json     @map("chunk_ids")
  referencedChunkIds Json?    @map("referenced_chunk_ids")
  queryText          String   @map("query_text")
  retrievedAt        DateTime @default(now()) @map("retrieved_at")

  investigation Investigation @relation(fields: [investigationId], references: [id])
  message       Message?      @relation(fields: [messageId], references: [id])

  @@index([investigationId, retrievedAt], map: "idx_rag_retrieval_log_investigation_id_retrieved_at")
  @@map("rag_retrieval_logs")
}

enum EvidenceType {
  IMAGE
  VIDEO
  AUDIO
}

/// Evidencia multimedia del caso (Technical Spec §10.6, PRD §65-79). D-011:
/// sin `deletedAt` — RSE-008 prohíbe el borrado de evidencia sin
/// excepción de estado, a diferencia de otras entidades del dominio.
model Evidence {
  id              String       @id @default(uuid())
  investigationId String       @map("investigation_id")
  evidenceType    EvidenceType @map("evidence_type")
  description     String?
  /// Null hasta que el job ANALYZE_EVIDENCE la complete. Para VIDEO/AUDIO
  /// queda null indefinidamente en esta fase — Claude solo analiza IMAGE
  /// (limitación documentada, D-011).
  analysisJson    Json?        @map("analysis_json")
  uploadedAt      DateTime     @default(now()) @map("uploaded_at")

  investigation Investigation @relation(fields: [investigationId], references: [id])
  attachments   Attachment[]

  @@index([investigationId, uploadedAt], map: "idx_evidence_investigation_id_uploaded_at")
  @@map("evidence")
}

/// Archivo físico asociado a una `Evidence`, en Supabase Storage
/// (Technical Spec §10.6). `checksum` (SHA-256) para verificar
/// integridad; el archivo original nunca se modifica (RSE-010).
model Attachment {
  id          String   @id @default(uuid())
  evidenceId  String   @map("evidence_id")
  storagePath String   @map("storage_path")
  mimeType    String   @map("mime_type")
  fileSize    Int      @map("file_size")
  checksum    String
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  evidence Evidence @relation(fields: [evidenceId], references: [id])

  @@map("attachments")
}

/// Informe consolidado, versionado por investigación (Technical Spec
/// §10.6/§10.10, PRD RI-009). Nunca se actualiza in-place: cada nueva
/// generación crea una fila nueva con `reportVersion` incremental; la
/// vigente se marca con `isLatest: true` (índice único parcial en la
/// migración garantiza una sola por investigación). Sin PDF (D-014).
model Report {
  id               String   @id @default(uuid())
  investigationId  String   @map("investigation_id")
  reportVersion    Int      @map("report_version")
  reportJson       Json     @map("report_json")
  generatedByModel String   @map("generated_by_model")
  generatedAt      DateTime @default(now()) @map("generated_at")
  isLatest         Boolean  @default(true) @map("is_latest")

  investigation Investigation @relation(fields: [investigationId], references: [id])

  @@unique([investigationId, reportVersion], map: "uq_reports_investigation_version")
  @@map("reports")
}
